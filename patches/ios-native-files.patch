 @interface GHOST_IOSFilePickerDelegate
     : NSObject <UIDocumentPickerDelegate, UIAdaptivePresentationControllerDelegate>
 @property(nonatomic, assign) GHOST_SystemIOS *ghostSystem;
+/** The Blender window that opened the picker. UIKit may change active-window state while the
+ * document browser is presented, so the callback must not rediscover this afterward. */
+@property(nonatomic, assign) GHOST_WindowIOS *ghostWindow;
+/** UIKit can report both a picker callback and an adaptive-presentation dismissal. */
+@property(nonatomic, assign) BOOL resultDelivered;
 /** For save-to-folder mode: the default filename to append to the chosen directory. */
 @property(nonatomic, copy) NSString *defaultFilename;
+- (void)deliverResultURL:(NSURL *)url;
 @end
 
 @implementation GHOST_IOSFilePickerDelegate
 
+- (void)deliverResultURL:(NSURL *)url
+{
+  if (_resultDelivered) {
+    return;
+  }
+  _resultDelivered = YES;
+
+  GHOST_SystemIOS *system = _ghostSystem;
+  if (!system) {
+    return;
+  }
+
+  /* Prefer the window that initiated the dialog. The system's active window can temporarily
+   * change while UIDocumentPickerViewController owns the presentation. */
+  GHOST_WindowIOS *window = _ghostWindow;
+  if (!window || !system->validWindow(window)) {
+    window = system->current_active_window;
+  }
+  if (!window || !system->validWindow(window)) {
+    NSLog(@"Blender Files: no valid Blender window for the document-picker result");
+    return;
+  }
+
+  char *pathCopy = nullptr;
+  if (url) {
+    storeSecurityScopedURL(url);
+
+    const char *path = url.fileSystemRepresentation;
+    if (!path) {
+      NSLog(@"Blender Files: selected URL has no file-system representation");
+      return;
+    }
+
+    const size_t pathLen = strlen(path);
+    pathCopy = static_cast<char *>(malloc(pathLen + 1));
+    if (!pathCopy) {
+      NSLog(@"Blender Files: could not allocate the selected path");
+      return;
+    }
+    memcpy(pathCopy, path, pathLen + 1);
+  }
+
+  system->pushEvent(std::make_unique<GHOST_EventString>(
+      system->getMilliSeconds(),
+      GHOST_kEventNativeFileDialogResult,
+      window,
+      static_cast<GHOST_TEventDataPtr>(pathCopy)));
+  system->notifyExternalEventProcessed();
+  window->needsDisplayUpdate();
+
+  NSLog(@"Blender Files: delivered %@ from the native document picker",
+        url ? url.lastPathComponent : @"cancel");
+}
