{$PUBLIC_ORIGIN} {
    request_body {
        max_size 3MB
    }

    # ChatGPT's OAuth browser flow may preserve Origin: https://chatgpt.com on
    # both the initial authorization navigation and the owner-consent form POST.
    # Strip Origin only for /authorize. The authorization request itself is
    # still bound to the pre-registered client, exact redirect URI, resource,
    # S256 PKCE challenge, a short-lived one-time ticket, and the owner key.
    @oauth_authorize {
        path /authorize
    }
    reverse_proxy @oauth_authorize relay:8080 {
        header_up -Origin
    }

    reverse_proxy relay:8080
}
