  * See source/blender/windowmanager/wm_ios_bridge.h for declarations. */
 #include "../../../../source/blender/windowmanager/wm_ios_bridge.h"
 
+/* URLs can arrive in launchOptions before GHOST has created a window. Retain them and only
+ * dispatch the Blender event after main_ios_callback has installed both the system and context. */
+static NSMutableArray<NSURL *> *s_pendingOpenURLs = nil;
+
+static void blender_ios_queueOpenURL(NSURL *url, NSString *source)
+{
+  if (!url || !url.isFileURL || !url.path) {
+    NSString *message =
+        [NSString stringWithFormat:@"%@ rejected non-file URL: %@", source, url];
+    GHOST_ios_logFileEvent((__bridge void *)message);
+    return;
+  }
+
+  /* Retain the provider-issued URL itself. Rebuilding an NSURL from url.path discards the
+   * provider's sandbox extension and makes an otherwise valid handoff unreadable. */
+  GHOST_ios_storeSecurityScopedURL((__bridge void *)url);
+
+  if (!s_pendingOpenURLs) {
+    s_pendingOpenURLs = [[NSMutableArray alloc] init];
+  }
+  for (NSURL *pendingURL in s_pendingOpenURLs) {
+    if ([pendingURL.path isEqualToString:url.path]) {
+      NSString *message =
+          [NSString stringWithFormat:@"%@ duplicate already queued: %@", source, url.path];
+      GHOST_ios_logFileEvent((__bridge void *)message);
+      return;
+    }
+  }
+
+  [s_pendingOpenURLs addObject:url];
+  NSString *message = [NSString
+      stringWithFormat:@"%@ queued: %@ (pending=%lu)",
+                       source,
+                       url.path,
+                       (unsigned long)s_pendingOpenURLs.count];
+  GHOST_ios_logFileEvent((__bridge void *)message);
+}
+
+static void blender_ios_deliverPendingOpenURLs()
+{
+  if (![NSThread isMainThread]) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+      blender_ios_deliverPendingOpenURLs();
+    });
+    return;
+  }
+  if (s_pendingOpenURLs.count == 0) {
+    return;
+  }
+
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  const BOOL applicationIsActive =
+      [UIApplication sharedApplication].applicationState == UIApplicationStateActive;
+  if (!applicationIsActive || !C || !system || !system->current_active_window ||
+      !system->validWindow(system->current_active_window))
+  {
+    NSString *message = [NSString
+        stringWithFormat:@"delivery deferred; app=%@ context=%@ system=%@ window=%@ pending=%lu",
+                         applicationIsActive ? @"active" : @"inactive",
+                         C ? @"ready" : @"missing",
+                         system ? @"ready" : @"missing",
+                         (system && system->current_active_window) ? @"ready" : @"missing",
+                         (unsigned long)s_pendingOpenURLs.count];
+    GHOST_ios_logFileEvent((__bridge void *)message);
+    return;
+  }
+
+  NSArray<NSURL *> *snapshot = [NSArray arrayWithArray:s_pendingOpenURLs];
+  for (NSURL *url in snapshot) {
+    GHOST_WindowIOS *window = system->current_active_window;
+    if (!system->handleOpenDocumentRequest(url.path)) {
+      NSString *message =
+          [NSString stringWithFormat:@"delivery deferred by GHOST: %@", url.path];
+      GHOST_ios_logFileEvent((__bridge void *)message);
+      continue;
+    }
+
+    [s_pendingOpenURLs removeObject:url];
+    system->notifyExternalEventProcessed();
+    if (window && system->validWindow(window)) {
+      window->needsDisplayUpdate();
+    }
+
+    NSString *message = [NSString
+        stringWithFormat:@"delivered open-main-file event: %@ (pending=%lu)",
+                         url.path,
+                         (unsigned long)s_pendingOpenURLs.count];
+    GHOST_ios_logFileEvent((__bridge void *)message);
+  }
+}
