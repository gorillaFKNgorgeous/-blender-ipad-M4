+- (BOOL)handleHardwarePresses:(NSSet<UIPress *> *)presses
+{
+  GHOST_SystemIOS *system = static_cast<GHOST_SystemIOS *>(GHOST_ISystem::getSystem());
+  if (system == nullptr) {
+    return NO;
+  }
+
+  BOOL handled = NO;
+  for (UIPress *press in presses) {
+    handled |= system->handleKeyEvent((void *)press) == GHOST_kSuccess;
+  }
+  return handled;
+}
