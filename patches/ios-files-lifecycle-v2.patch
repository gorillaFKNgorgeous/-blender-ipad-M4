 #import <UniformTypeIdentifiers/UniformTypeIdentifiers.h>
 #import <objc/runtime.h>
 
+#pragma mark - Persistent File-Handoff Diagnostics
+
+static NSObject *s_fileLogLock = [[NSObject alloc] init];
+
+static NSURL *fileHandoffLogURL()
+{
+  NSURL *documentsURL =
+      [[[NSFileManager defaultManager] URLsForDirectory:NSDocumentDirectory
+                                              inDomains:NSUserDomainMask] firstObject];
+  return [documentsURL URLByAppendingPathComponent:@"BlenderFiles.log"];
+}
+
+void GHOST_ios_resetFileLog()
+{
+  @autoreleasepool {
+    @synchronized(s_fileLogLock) {
+      NSURL *logURL = fileHandoffLogURL();
+      if (logURL) {
+        [[NSFileManager defaultManager] removeItemAtURL:logURL error:nil];
+      }
+    }
+  }
+}
+
+void GHOST_ios_logFileEvent(void *nsstring)
+{
+  @autoreleasepool {
+    NSString *message = (NSString *)nsstring;
+    if (!message) {
+      return;
+    }
+
+    NSString *line = [NSString
+        stringWithFormat:@"%@ | %@\n", [[NSDate date] descriptionWithLocale:nil], message];
+    NSLog(@"Blender Files: %@", message);
+
+    @synchronized(s_fileLogLock) {
+      NSURL *logURL = fileHandoffLogURL();
+      NSData *data = [line dataUsingEncoding:NSUTF8StringEncoding];
+      if (!logURL || !data) {
+        return;
+      }
+
+      NSFileManager *fileManager = [NSFileManager defaultManager];
+      if (![fileManager fileExistsAtPath:logURL.path]) {
+        [fileManager createFileAtPath:logURL.path contents:nil attributes:nil];
+      }
+
+      NSError *error = nil;
+      NSFileHandle *handle = [NSFileHandle fileHandleForWritingToURL:logURL error:&error];
+      if (!handle) {
+        NSLog(@"Blender Files: could not open diagnostic log: %@", error);
+        return;
+      }
+      [handle seekToEndOfFile];
+      [handle writeData:data];
+      [handle closeFile];
+    }
+  }
+}
