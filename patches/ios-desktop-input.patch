+GHOST_TSuccess GHOST_SystemIOS::handleKeyEvent(void *eventPtr)
+{
+  UIPress *press = static_cast<UIPress *>(eventPtr);
+  if (press == nil || press.key == nil) {
+    return GHOST_kFailure;
+  }
+
+  GHOST_IWindow *window = window_manager_->getActiveWindow();
+  if (window == nullptr) {
+    return GHOST_kFailure;
+  }
+
+  modifier_mask_ = uint32_t(press.key.modifierFlags);
+  const GHOST_TKey key_code = convertIOSKeyToGHOST(long(press.key.keyCode));
+  if (key_code == GHOST_kKeyUnknown) {
+    return GHOST_kFailure;
+  }
+
+  char utf8_buf[6] = {'\0'};
+  NSString *characters = press.key.characters;
+  if (characters.length > 0) {
+    NSData *encoded = [characters dataUsingEncoding:NSUTF8StringEncoding];
+    if (encoded.length > 0 && encoded.length < sizeof(utf8_buf)) {
+      memcpy(utf8_buf, encoded.bytes, encoded.length);
+    }
+  }
+
+  /* Navigation, function and Command shortcuts do not represent text insertion. */
+  if (((key_code >= GHOST_kKeyLeftArrow) && (key_code <= GHOST_kKeyDownArrow)) ||
+      ((key_code >= GHOST_kKeyF1) && (key_code <= GHOST_kKeyF24)) ||
+      (modifier_mask_ & UIKeyModifierCommand))
+  {
+    utf8_buf[0] = '\0';
+  }
+
+  switch (press.phase) {
+    case UIPressPhaseBegan:
+      pushEvent(std::make_unique<GHOST_EventKey>(getMilliSeconds(),
+                                                 GHOST_kEventKeyDown,
+                                                 window,
+                                                 key_code,
+                                                 false,
+                                                 utf8_buf));
+      return GHOST_kSuccess;
+    case UIPressPhaseChanged:
+    case UIPressPhaseStationary:
+      pushEvent(std::make_unique<GHOST_EventKey>(getMilliSeconds(),
+                                                 GHOST_kEventKeyDown,
+                                                 window,
+                                                 key_code,
+                                                 true,
+                                                 utf8_buf));
+      return GHOST_kSuccess;
+    case UIPressPhaseEnded:
+    case UIPressPhaseCancelled:
+      pushEvent(std::make_unique<GHOST_EventKey>(
+          getMilliSeconds(), GHOST_kEventKeyUp, window, key_code, false, nullptr));
+      return GHOST_kSuccess;
+  }
+
+  return GHOST_kFailure;
+}
