@@ -539,10 +539,22 @@ void MTLBackend::capabilities_init(MTLContext *ctx)
   GCaps.geometry_shader_support = false;
 
 #ifdef WITH_APPLE_CROSSPLATFORM
-  /* TODO(iOS IOS-002): Unlimited concurrent Metal shader compilation triggers jetsam on older
-   * iPads. Fixed cap for now; should be dynamic based on thermal + memory state. See
-   * doc/ios/known_issues.md. */
-  GCaps.max_parallel_compilations = 2;
+  /* Keep the proven low-memory jetsam guard, but do not impose the same fixed limit on
+   * high-memory iPad Pro hardware. A 12 GiB threshold separates the 16 GiB M4/M5 class from
+   * lower-memory devices. Leave one performance core available for the interactive UI. */
+  const uint64_t physical_memory = [NSProcessInfo processInfo].physicalMemory;
+  const bool high_memory_device = physical_memory >= (12ull * 1024ull * 1024ull * 1024ull);
+  const NSProcessInfoThermalState thermal_state = [NSProcessInfo processInfo].thermalState;
+  const bool thermally_constrained = thermal_state >= NSProcessInfoThermalStateSerious;
+  if (high_memory_device && !thermally_constrained) {
+    GCaps.max_parallel_compilations = std::max(
+        2,
+        std::min(BLI_system_thread_count(),
+                 MTLBackend::capabilities.num_performance_cores - 1));
+  }
+  else {
+    GCaps.max_parallel_compilations = 2;
+  }
 #else
   /* Compile shaders on performance cores but leave one free so UI is still responsive.
    * Also respect command line option to reduce number of threads. */
