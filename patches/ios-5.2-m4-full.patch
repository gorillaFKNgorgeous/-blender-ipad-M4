+create_extension_plist() {
+  local info_plist="$1"
+  local module_name="$2"
+  local bundle_identifier="$3"
+
+  rm -f "$info_plist"
+  plutil -create xml1 "$info_plist"
+  plutil -insert CFBundleDevelopmentRegion -string en "$info_plist"
+  plutil -insert CFBundleExecutable -string "$module_name" "$info_plist"
+  plutil -insert CFBundleIdentifier -string "$bundle_identifier" "$info_plist"
+  plutil -insert CFBundleInfoDictionaryVersion -string 6.0 "$info_plist"
+  plutil -insert CFBundlePackageType -string APPL "$info_plist"
+  plutil -insert CFBundleShortVersionString -string 1.0 "$info_plist"
+  plutil -insert CFBundleSupportedPlatforms -json '["iPhoneOS"]' "$info_plist"
+  plutil -insert MinimumOSVersion -string "${IPHONEOS_DEPLOYMENT_TARGET:-26.0}" "$info_plist"
+  plutil -insert CFBundleVersion -string 1 "$info_plist"
